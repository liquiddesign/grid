{control filterForm}
<div class="table-responsive">
	{form form}
	<table class="table table-sm lqd-table">
		<thead class="admin-head">
		{foreach $columns as $column}
			{$column->renderHeaderCell()|noescape}
		{/foreach}
		</thead>
		{$control->getRows()}
	</table>
	<div>
		{foreach $form->getComponents() as $component}
			{if $component instanceof Nette\Forms\Controls\SubmitButton}{$component->getControl()}{/if}
		{/foreach}
	</div>
{/form}
</div>
{control paging $control}